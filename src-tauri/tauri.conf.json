{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phenoblend",
  "version": "0.4.17",
  "identifier": "org.p2gx.phenoblend",
  "build": {
    "beforeDevCommand": "npx nx serve phenoblend --configuration=development  --no-cloud",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx nx build phenoblend --configuration=production  --no-cloud",
    "frontendDist": "../dist/phenoblend/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "phenoblend",
        "width": 1400,
        "height": 950,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
     
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
     "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
